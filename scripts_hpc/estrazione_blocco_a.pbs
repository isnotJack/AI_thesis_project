#!/bin/bash
#PBS -N estrazione_blocco_a
#PBS -q gpu
#PBS -l select=1:ncpus=32:ngpus=4,walltime=06:00:00
#PBS -o scripts_hpc/log_estrazione.out
#PBS -e scripts_hpc/log_estrazione.err

# Job PBS per l'estrazione LMM del Blocco A su Leonardo (DaVinci-1).
# Richiede 4 GPU e lancia l'estrazione in parallelo (un server Ollama +
# un worker per GPU) via scripts_hpc/estrazione_parallela.sh.
#
# Uso:
#   cd ~/AI_thesis_project        # submit sempre dalla root del progetto
#   qsub scripts_hpc/estrazione_blocco_a.pbs
#
# Resumable: se il walltime scade a meta', rilancia lo stesso comando -
# le combinazioni (paese, trimestre) gia' estratte vengono saltate, la
# scrittura e' atomica quindi non restano file troncati. Puoi fermare e
# riprendere su piu' giorni senza rompere nulla.
#
# Nota versione Ollama: si usa 0.12.11 (pinnata dentro il launcher): le
# versioni >=0.13.x hanno una regressione nota nel calcolo RoPE per
# Qwen2.5-VL su CUDA - https://github.com/ollama/ollama/issues/13630

cd "$PBS_O_WORKDIR"
NGPU=4 bash scripts_hpc/estrazione_parallela.sh
